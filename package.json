{
  "name": "n8n-nodes-nordstellar",
  "version": "0.1.0",
  "description": "n8n community node for the NordStellar Integration API (v3)",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "nordstellar",
    "nordsecurity",
    "threat-intelligence",
    "dark-web"
  ],
  "license": "MIT",
  "homepage": "https://github.com/NordStellar/n8n-nodes-nordstellar",
  "author": {
    "name": "NordStellar",
    "email": "support@nordstellar.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NordStellar/n8n-nodes-nordstellar.git"
  },
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/NordStellarIntegrationApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/NordStellar/NordStellar.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.33.1",
    "eslint": "9.29.0",
    "n8n-workflow": "2.16.0",
    "prettier": "3.8.3",
    "release-it": "20.2.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
